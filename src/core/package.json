{
	"name": "openvole",
	"version": "4.21.1",
	"description": "Micro-agent core — the minimal loop that makes agentic behavior possible",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"vole": "./dist/cli.js",
		"openvole": "./dist/cli.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsx src/cli.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@openvole/dashboard-server": "workspace:*",
		"@openvole/volenet": "workspace:*",
		"croner": "^10.0.1",
		"dotenv": "^16.6.1",
		"execa": "^9.6.1",
		"mitt": "^3.0.1",
		"ws": "^8.22.0",
		"yaml": "^2.9.1",
		"zod": "^3.25.76"
	},
	"optionalDependencies": {
		"dockerode": "^5.0.1"
	},
	"devDependencies": {
		"@types/dockerode": "^3.3.47",
		"@types/node": "^22.20.5",
		"@types/ws": "^8.18.2",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"dist",
		"README.md"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/openvole/openvole",
		"directory": "src/core"
	},
	"homepage": "https://openvole.github.io/openvole/",
	"keywords": [
		"ai",
		"agent",
		"microkernel",
		"llm",
		"tools",
		"mcp"
	]
}
